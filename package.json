{
  "name": "diggy",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "DNS made friendly — a comprehensive DNS, SSL & domain audit tool",
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run typecheck && npm run test"
  },
  "//overrides": "qs: express 4 pinnt ~6.14.0, die drei Advisories (GHSA-4mjr-xmp4-gh2g, GHSA-x5fp-wj9c-mxmx, GHSA-q8mj-m7cp-5q26) sind erst in 6.15.4 behoben — npm audit fix kann den Pin nicht auflösen. body-parser, das express selbst mitbringt, steht schon auf ~6.16.0: der Override zieht nur express' eigenen Query-Parser auf dieselbe Reihe. Kann raus, sobald express die Range hebt.",
  "overrides": {
    "qs": "^6.16.0"
  },
  "dependencies": {
    "@fontsource/geist": "^5.3.0",
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/goldman": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.1",
    "framer-motion": "^11.11.0",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.460.0",
    "nodemailer": "^10.0.1",
    "react": "^19.3.0",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "tldts": "^7.4.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.5",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "postcss": "^8.4.49",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
