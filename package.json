{
  "name": "diggy",
  "private": true,
  "version": "0.4.0",
  "license": "MIT",
  "type": "module",
  "description": "DNS made friendly — a comprehensive DNS, SSL & domain audit tool",
  "scripts": {
    "dev": "concurrently \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "npm run typecheck && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "i18n": "node scripts/check-i18n.mjs",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "size": "node scripts/check-bundle-size.mjs",
    "smoke": "node scripts/smoke-server.mjs",
    "test:watch": "vitest",
    "verify": "npm run lint && npm run i18n && npm run typecheck && npm run test && npm run build && npm run smoke && npm run size",
    "e2e": "tsc -p tsconfig.e2e.json && playwright test",
    "e2e:docker": "node e2e/run-in-docker.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "nodemailer": "^10.1.2",
    "tldts": "^7.4.18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/goldman": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@mittwald/flow-react-components": "1.5.50",
    "@mittwald/react-use-promise": "4.3.0",
    "@playwright/test": "1.64.1",
    "@tabler/icons-react": "3.49.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-aria-components": "1.22.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.91.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
