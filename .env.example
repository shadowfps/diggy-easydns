# SMTP — Kontaktformular (Impressum)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Empfänger & Absender (CONTACT_FROM = Absender für Bestätigungs-Mail an Nutzer)
CONTACT_TO=
CONTACT_FROM=

# Geheimer Schlüssel für Anti-Spam-Token.
# In Produktion PFLICHT und mindestens 32 Zeichen — ohne ihn startet der Server
# nicht, sobald SMTP konfiguriert ist. Erzeugen mit: openssl rand -base64 32
CONTACT_FORM_SECRET=

# Hinter Reverse-Proxy (nginx, Caddy): true setzen für korrektes IP-Rate-Limiting
# TRUST_PROXY=true

# Optional: Origins, die per CORS zugreifen dürfen (komma-separiert).
# Leer lassen, wenn Frontend und API unter derselben Origin laufen (Standard).
# CORS_ORIGINS=https://diggy.example

# Optional: PageSpeed, VirusTotal, Port
PAGESPEED_API_KEY=
VIRUS_TOTAL_API_KEY=
PORT=3001
